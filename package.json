{
  "name": "notely",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/copy-backend.mjs && node scripts/copy-tests.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:static-build": "node scripts/test-static-build.mjs",
    "dev:api": "php -S 127.0.0.1:8080 backend/dev-router.php",
    "test:php": "php tests/backend/php/security.php && php tests/backend/php/configuration.php && php tests/backend/php/note-html-clean.php",
    "test:note-sort-filter": "node tests/backend/http/note-sort-filter-http.mjs",
    "test:note-category-filter": "node tests/backend/http/note-category-filter-http.mjs",
    "test:accounts": "node tests/backend/http/http.mjs",
    "test:note-titles": "node tests/backend/http/note-titles-http.mjs",
    "test:note-sorting": "node tests/backend/http/note-sorting-http.mjs",
    "test:note-categories": "node tests/backend/http/note-categories-http.mjs",
    "test:schema": "php tests/backend/php/schema.php",
    "test:syllabus-upload": "php tests/backend/php/syllabus-upload.php",
    "test:syllabus-upload-http": "node tests/backend/http/syllabus-upload-http.mjs",
    "test:import-confirm": "php tests/backend/php/import-confirm.php",
    "test:import-confirm-http": "node tests/backend/http/import-confirm-http.mjs",
    "test:event-delete": "node tests/backend/http/event-delete-http.mjs",
    "test:schedule-shares": "node tests/backend/http/schedule-shares-http.mjs",
    "test:syllabus-ai": "php tests/backend/php/syllabus-ai.php",
    "test:import-extract": "php tests/backend/php/import-extract.php",
    "test:import-extract-http": "node tests/backend/http/import-extract-http.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@fontsource-variable/inter": "^5.2.5",
    "@tiptap/extension-highlight": "3.34.0",
    "@tiptap/extension-task-item": "3.34.0",
    "@tiptap/extension-task-list": "3.34.0",
    "@tiptap/extension-text-align": "3.34.0",
    "@tiptap/extension-text-style": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
