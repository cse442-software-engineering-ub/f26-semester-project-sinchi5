{
  "name": "notely",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/copy-backend.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:static-build": "node scripts/test-static-build.mjs",
    "dev:api": "php -S 127.0.0.1:8080 backend/dev-router.php",
    "test:php": "php backend/tests/security.php && php backend/tests/configuration.php",
    "test:note-category-filter": "node backend/tests/note-category-filter-http.mjs",
    "test:accounts": "node backend/tests/http.mjs",
    "test:note-titles": "node backend/tests/note-titles-http.mjs",
    "test:schema": "php backend/tests/schema.php"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@fontsource-variable/inter": "^5.2.5",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
